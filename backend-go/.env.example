# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
# Comma-separated CORS allow-list. Defaults to the statvio.com origins if unset.
ALLOWED_ORIGINS=https://www.statvio.com,https://statvio.com
FRONTEND_SPOTIFY_URL=http://localhost:5173/dashboard

# ── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/statvio?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-the-same-secret-the-node-service-uses

# ── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=accessKeyId
AWS_SECRET_ACCESS_KEY=secretAccessKey
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=bucketName

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Spotify ─────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=clientId
SPOTIFY_CLIENT_SECRET=clientSecret
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/music/spotify/callback
SPOTIFY_AUTH_URL=https://accounts.spotify.com
SPOTIFY_API_URL=https://api.spotify.com/v1

# ── Stripe (replaces PayPal) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=http://localhost:5173/subscribe/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/subscribe/cancel
